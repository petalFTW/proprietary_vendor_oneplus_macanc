prebuilt_etc {
    name: "com.oplus.camera.unit.sdk_product.xml",
    src: "com.oplus.camera.unit.sdk_product.xml",
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "public.libraries-oplus.txt",
    src: "public.libraries-oplus.txt",
    system_ext_specific: true,
}

// oplus' wrapper round the qcom hal, ro.hardware.camera points here. it's what publishes
// supported.cameraid.type, without it the sdk's camera table stays empty
cc_prebuilt_library_shared {
    name: "camera.oemlayer.v2",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["odm/lib64/hw/camera.oemlayer.v2.so"],
        },
    },
    compile_multilib: "64",
    relative_install_path: "hw",
    check_elf_files: false,
    prefer: true,
    device_specific: true,
}

// the sdk's aps configs are encrypted, this decodes them. stock loads it through sphal
cc_prebuilt_library_shared {
    name: "libOplusSecurity",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["odm/lib64/libOplusSecurity.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    device_specific: true,
}
