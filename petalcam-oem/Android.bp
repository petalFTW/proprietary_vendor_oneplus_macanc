// hand kept, setup-makefiles has no idea this folder exists

dex_import {
    name: "com.oplus.camera.unit.sdk",
    jars: ["product/framework/com.oplus.camera.unit.sdk.jar"],
    product_specific: true,
}

dex_import {
    name: "com.oplus.camera.unit.sdk.adapter",
    jars: ["product/framework/com.oplus.camera.unit.sdk.adapter.jar"],
    product_specific: true,
}

dex_import {
    // frameworks/ex already owns the plain name
    name: "petalcam-camera-extensions-impl",
    stem: "androidx.camera.extensions.impl",
    jars: ["system_ext/framework/androidx.camera.extensions.impl.jar"],
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libAPSClient-alog-jni",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["product/lib64/libAPSClient-alog-jni.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    product_specific: true,
}

